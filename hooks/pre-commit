#!/usr/bin/env bash
# Pre-commit hook for spacesim2.
#
# Enforces formatting (`ruff format`) on staged Python files, using the
# project's uv-pinned ruff so the version always matches uv.lock.
#
# Bypass once with:  git commit --no-verify
#
# NOTE: lint (`ruff check`) and types (`mypy`) are NOT enforced here yet — the
# tree still has a backlog of both. Run them manually:
#     uv run ruff check .
#     uv run mypy .
# Promote them into this hook once the backlog is cleared (see CLAUDE.md).
set -euo pipefail

# Staged, still-present Python files (added/copied/modified), NUL-delimited so
# paths with spaces survive.
mapfile -d '' -t files < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if ! uv run ruff format --check "${files[@]}"; then
  {
    echo
    echo "✗ ruff format: staged files are not formatted. Fix with:"
    echo "    uv run ruff format ${files[*]}"
    echo "  then 'git add' them and recommit (or 'git commit --no-verify' to skip)."
  } >&2
  exit 1
fi
